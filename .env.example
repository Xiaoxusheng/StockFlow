# ===== StockFlow Docker 部署环境变量（复制为 .env 后填写；勿提交 git）=====
# 强随机值生成：openssl rand -base64 32
# 全部 SF_* 变量说明见 docs/deployment.md §1.1

# —— 数据与缓存容器 ——
# PostgreSQL 管理凭据（仅首次初始化生效；之后改密需进容器执行 ALTER USER）
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=
POSTGRES_DB=stockflow
# Redis 访问密码（容器 requirepass）
REDIS_PASSWORD=

# —— 应用（SF_*）——
# 服务模式：生产固定 release（本地开发才显式设 debug）
SF_SERVER_MODE=release
# JWT 签名密钥：release 下缺失即启动失败（必填），openssl rand -base64 32
SF_AUTH_JWT_SECRET=
# 设备令牌（M3 设备域）签名密钥：与用户 JWT 密钥隔离的另一凭证族，
# release 下缺失即启动失败，≥16 字节；openssl rand -base64 32
SF_DEVICES_JWT_SECRET=
# 空库首次启动必填：≥12 位且含大小写字母/数字/符号中至少三类；
# 首次登录后立即改密，公网放行前确认已改密（deployment.md §7.1）
SF_ADMIN_INITIAL_PASSWORD=
# 单机 compose 内网流量不出主机可保持 disable；数据库跨机时必须 verify-full
SF_DATABASE_SSLMODE=disable
# 受信反代网段（X-Forwarded-For 信任来源）：
#   启用 web 反代容器或外置 nginx 在同机 Docker 网络时设 172.16.0.0/12；
#   直连 8080（无反代）保持留空
SF_SERVER_TRUSTED_PROXIES=
# CORS 白名单（逗号分隔）。经 web 容器同源访问时后端收到的请求同源，保持默认即可
SF_CORS_ALLOWED_ORIGINS=http://localhost:5173
# —— 端口绑定 ——
# 默认只绑服务器回环（配合反代/SSH 隧道验证）；临时直连改 0.0.0.0
APP_BIND=127.0.0.1
WEB_BIND=127.0.0.1
